---
import { Icon } from "astro-icon/components";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { formatDateToYYYYMMDD } from "@/utils/date-utils";
import {
	getSeriesChapters,
	getSeriesList,
	groupChaptersByVolume,
} from "@/utils/series-utils";
import { getPostUrlBySlug, getSeriesUrl } from "@/utils/url-utils";

export async function getStaticPaths() {
	const seriesList = await getSeriesList();
	return await Promise.all(
		seriesList.map(async (series) => ({
			params: { slug: series.slug },
			props: {
				series,
				chapters: await getSeriesChapters(series.slug),
			},
		})),
	);
}

const { series, chapters } = Astro.props;
const volumeGroups = groupChaptersByVolume(chapters);
---

<MainGridLayout title={series.title}>
    <!-- 合集标题 -->
    <div class="card-base px-8 py-6 mb-4 onload-animation">
        <a
            href={getSeriesUrl("")}
            class="text-sm text-30 hover:text-(--primary) transition mb-1 inline-block"
        >
            {i18n(I18nKey.series)}
        </a>
        <div class="text-2xl font-bold text-(--primary) mb-2">
            {series.title}
        </div>
        <p class="text-30 text-sm flex flex-wrap items-center gap-x-3">
            <span>
                {series.chapterCount} {i18n(I18nKey.seriesChaptersCount)}
            </span>
            <span>{formatDateToYYYYMMDD(series.latestDate)}</span>
        </p>
    </div>

    <!-- 章节目录 -->
    <div class="card-base px-6 md:px-8 py-6 mb-4 onload-animation" style="animation-delay: calc(var(--content-delay) + 50ms);">
        {
            volumeGroups.map((group) => (
                <div class="mb-4 last:mb-0">
                    {group.volume && (
                        <div class="text-lg font-bold text-90 mt-2 mb-2 first:mt-0">
                            {group.volume}
                        </div>
                    )}
                    <div class="flex flex-col">
                        {group.chapters.map((post) => (
                            <a
                                href={getPostUrlBySlug(post.id)}
                                class="group flex items-center gap-3 py-2.5 border-b border-(--line-divider) last:border-none"
                            >
                                <div class="shrink-0 w-9 h-8 rounded-lg bg-(--btn-regular-bg) text-(--btn-content) flex items-center justify-center text-sm font-bold">
                                    {post.data.chapter ?? "·"}
                                </div>
                                <div class="min-w-0 flex-1 truncate text-90 font-medium group-hover:text-(--primary) transition">
                                    {post.data.title}
                                </div>
                                <div class="shrink-0 text-sm text-30 hidden sm:block">
                                    {formatDateToYYYYMMDD(post.data.published)}
                                </div>
                                <Icon
                                    name="material-symbols:chevron-right-rounded"
                                    class="shrink-0 text-xl text-30 group-hover:text-(--primary) transition"
                                />
                            </a>
                        ))}
                    </div>
                </div>
            ))
        }

        {
            chapters.length === 0 && (
                <p class="text-30 text-center py-6">{i18n(I18nKey.noData)}</p>
            )
        }
    </div>
</MainGridLayout>

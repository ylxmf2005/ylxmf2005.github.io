---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import { getPostUrl } from "@/utils/getPostPaths";
import { getChineseSeries, type Series } from "@/utils/series";
import config from "@/config";

export async function getStaticPaths() {
  const seriesList = await getChineseSeries();
  return seriesList.map(series => ({
    params: { slug: series.slug },
    props: { series },
  }));
}

type Props = { series: Series };
const { series } = Astro.props;
---

<Layout title={`${series.title} | ${config.site.title}`}>
  <Header />
  <Breadcrumb />
  <Main pageTitle={series.title} pageDesc="">
    <ol class="list-decimal ps-6">
      {
        series.posts.map(post => (
          <li class="my-5 ps-2">
            <a
              class="text-accent text-lg font-medium hover:underline"
              href={getPostUrl(post.id, post.filePath, "zh")}
            >
              {post.data.title}
            </a>
            <p class="text-muted-foreground mt-1">{post.data.description}</p>
          </li>
        ))
      }
    </ol>
  </Main>
  <Footer />
</Layout>

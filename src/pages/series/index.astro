---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import { getChineseSeries } from "@/utils/series";
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";

export async function getStaticPaths() {
  return [{ params: {}, props: {} }];
}

const seriesList = await getChineseSeries();
const locale = Astro.currentLocale ?? config.site.lang;
---

<Layout title={`系列 | ${config.site.title}`}>
  <Header />
  <Breadcrumb />
  <Main pageTitle="系列" pageDesc="">
    <ul class="divide-border divide-y">
      {
        seriesList.map(series => (
          <li class="py-6 first:pt-2">
            <a
              class="text-accent inline-block text-xl font-semibold hover:underline"
              href={getRelativeLocaleUrl(locale, `series/${series.slug}`)}
            >
              {series.title}
            </a>
            <p class="text-muted-foreground mt-2">{series.posts.length} 章</p>
          </li>
        ))
      }
    </ul>
  </Main>
  <Footer />
</Layout>
